<UserControl x:Class="NationalInstruments.VeriStand.EngineExplodedView.EngineExplodedViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helix="http://helix-toolkit.org/wpf"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="480"
             x:Name="Root">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6EAEE" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE6EAEE" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF2B3440" Offset="0" />
                <GradientStop Color="#FF0F1318" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <helix:HelixViewport3D x:Name="Viewport"
                               Grid.Row="0"
                               Background="Transparent"
                               ShowCoordinateSystem="True"
                               ShowViewCube="True"
                               ZoomExtentsWhenLoaded="False"
                               IsHeadLightEnabled="False"
                               ClipToBounds="True"
                               MouseLeftButtonUp="OnViewportMouseLeftButtonUp">
            <helix:HelixViewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" FieldOfView="40" />
            </helix:HelixViewport3D.Camera>
            <helix:DefaultLights />
            <ModelVisual3D x:Name="EngineRoot" />
            <ModelVisual3D x:Name="LabelRoot" />
        </helix:HelixViewport3D>

        <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                Background="#B0151A20" CornerRadius="3" Padding="8,4" MaxWidth="260">
            <StackPanel>
                <TextBlock Text="Turbofan Exploded View" FontWeight="Bold" FontSize="12" />
                <TextBlock x:Name="SelectionName" Text="Click a part to inspect it" Foreground="#FF8FC3FF" Margin="0,2,0,0" />
                <TextBlock x:Name="SelectionDescription" TextWrapping="Wrap" Foreground="#FFB8C2CC" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#E0151A20" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Explode" Margin="0,0,6,0" />
                <Slider x:Name="ExplodeSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        Value="{Binding ExplodeFactor, ElementName=Root, Mode=TwoWay}"
                        PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button Content="Explode" Click="OnExplodeClick" />
                    <Button Content="Assemble" Click="OnAssembleClick" />
                    <Button Content="Reset View" Click="OnResetViewClick" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <CheckBox Content="Spin" IsChecked="{Binding IsSpinning, ElementName=Root, Mode=TwoWay}" />
                    <CheckBox Content="Labels" IsChecked="{Binding ShowLabels, ElementName=Root, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
